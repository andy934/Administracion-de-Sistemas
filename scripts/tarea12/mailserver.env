# =============================================================
# CONFIGURACION PRINCIPAL DEL SERVIDOR DE CORREO
# docker-mailserver - reprobados.com
# =============================================================

# Dominio y hostname
OVERRIDE_HOSTNAME=mail.reprobados.com

# Protocolos habilitados
SMTP_ONLY=0
ENABLE_IMAP=1

# TLS - usamos certificados autofirmados generados por setup.sh
SSL_TYPE=manual
SSL_CERT_PATH=/etc/letsencrypt/live/mail.reprobados.com/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/mail.reprobados.com/privkey.pem

# Forzar TLS en SMTP
POSTFIX_FORCE_TLS=1

# DKIM
ENABLE_OPENDKIM=1

# Spam y antivirus
ENABLE_RSPAMD=1
ENABLE_CLAMAV=0

# Fail2Ban
ENABLE_FAIL2BAN=1
FAIL2BAN_BLOCKTYPE=drop

# Logs persistentes
LOG_LEVEL=info
POSTFIX_LOGLEVEL=3

# Autenticacion
ENABLE_SASLAUTHD=0
POSTFIX_INET_PROTOCOLS=ipv4

# Limites de tamano de mensaje (10MB)
POSTFIX_MESSAGE_SIZE_LIMIT=10240000

# SPF
ENABLE_SPF=1

# Politica de relay - solo correo local, no abierto
POSTFIX_RELAYHOST=

# Usuarios virtuales (se crean con setup.sh)
ACCOUNT_PROVISIONER=FILE
