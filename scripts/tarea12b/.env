# ═══════════════════════════════════════════════════════════════
# .env — Variables de entorno Parte 2 (Roundcube + MariaDB)
# NUNCA subir a repositorio público
# ═══════════════════════════════════════════════════════════════

# ── MariaDB ─────────────────────────────────────────────────────
DB_ROOT_PASSWORD=RootDB.Practica12!
DB_NAME=roundcubemail
DB_USER=roundcube
DB_PASSWORD=RC.Practica12!

# ── Sesión Roundcube (clave de 24 caracteres exactos) ───────────
SESSION_KEY=Rc24CharKeyPractica12!!
echo "ROUNDCUBEMAIL_IMAP_CONN_OPTIONS=[\"ssl\"=>[\"verify_peer\"=>false,\"verify_peer_name\"=>false,\"allow_self_signed\"=>true]]" >> .env
echo "ROUNDCUBEMAIL_SMTP_CONN_OPTIONS=[\"ssl\"=>[\"verify_peer\"=>false,\"verify_peer_name\"=>false,\"allow_self_signed\"=>true]]" >> .env
